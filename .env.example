# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000

# DATABASE_PATH: Path to SQLite database file (default: data/jobpilot.db)
DATABASE_PATH="data/jobpilot.db"

# Optional Enterprise Partner Credentials for Job Portals:
# If omitted, JobPilot AI honestly marks the source as "Awaiting Credentials"
# and offers the direct CSV/JSON dataset ingestion pipeline fallback.
NAUKRI_API_KEY=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
INTERNSHALA_API_KEY=""
FOUNDIT_API_KEY=""
