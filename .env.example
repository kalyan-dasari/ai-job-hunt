# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000

# DATABASE_PATH: Path to SQLite database file (default: data/jobpilot.db)
DATABASE_PATH="data/jobpilot.db"

# =========================================================================
# DOSSIER ARCHITECTURE — PRIMARY JOB DISCOVERY CHANNELS (SERVER-SIDE ONLY)
# =========================================================================

# 1. JSearch API (RapidAPI) — Primary Aggregated Job Discovery (Free Tier: 200 req/month)
# Provides aggregated search across LinkedIn, Indeed, Glassdoor & Indian tech portals.
JSEARCH_API_KEY=""

# 2. Adzuna API — Secondary Aggregated Job Discovery (Free Tier: 250 req/month)
# Official developer endpoint for India (https://developer.adzuna.com/)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# 3. Direct Corporate Career Boards (Greenhouse, Lever, Ashby, Jobicy)
# Zero configuration required. Free public ATS feeds with automated corroboration.

# Optional Legacy / Enterprise Connector Keys:
NAUKRI_API_KEY=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
INTERNSHALA_API_KEY=""
FOUNDIT_API_KEY=""
