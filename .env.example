# =================================================================
# JobPilot AI v1.0 — Environment Configuration
# =================================================================

# Server port (default: 3000)
PORT=3000

# Node execution environment ('production' or 'development')
NODE_ENV=production

# SQLite database storage path
# Default: ./data/jobpilot.db (inside container: /app/data/jobpilot.db)
DATABASE_PATH=./data/jobpilot.db

# Optional: Google Gemini API Key for semantic resume extraction & AI tailoring
# Note: JobPilot AI functions 100% deterministically at ₹0 operating cost without any API key.
# If omitted, deterministic rule-based parsing and keyword tailoring will be used automatically.
# GEMINI_API_KEY=your_gemini_api_key_here
